# Base URL of the backend API (matches the previous axiosInstance base path)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# The previous PaymentForm.jsx posted directly to http://localhost:8080/api/payment —
# no "/v1" segment, unlike every other endpoint. That may be intentional (a separate
# route group on the backend) or a leftover mistake — kept as its own base rather than
# guessed into /api/v1, so it's easy to point wherever the real route lives.
REACT_APP_PAYMENT_BASE_URL=http://localhost:8080/api

# Stripe publishable key — the previous version shipped with the literal
# placeholder string 'your-publishable-key-here', which would fail at runtime.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Works around a react-scripts 5 + modern-npm ESLint webpack plugin crash
# (see README) — unrelated to this project's code.
DISABLE_ESLINT_PLUGIN=true
